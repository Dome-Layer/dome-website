{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo"
  },
  "include": ["api/**/*.ts", "middleware.ts", "middleware.test.ts", "src/i18n/cookie.ts", "src/i18n/detect.ts", "src/i18n/locales.ts", "src/i18n/routes.ts"]
}
