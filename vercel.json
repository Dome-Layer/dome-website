{
  "installCommand": "rm -rf node_modules/@dome-layer/dome-ui && npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "headers": [
    {
      "source": "/favicon(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/media/CREDITS.md",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/apple-touch-icon(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://domelayer.com 'wasm-unsafe-eval'; style-src 'self' https://domelayer.com 'unsafe-inline'; font-src 'self' https://domelayer.com data:; img-src 'self' https://domelayer.com data: blob:; connect-src 'self' https://domelayer.com https://kuurkyfenexakxahxczn.supabase.co https://kzzljogzlpzzrdyjaqtw.supabase.co https://*.up.railway.app https://auth.domelayer.com https://auth.staging.domelayer.com https://*.ingest.de.sentry.io; worker-src 'self' blob:; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "staging.domelayer.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "suf": ".vercel.app" } }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/tools/:slug",
      "destination": "/dome/:slug",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/dome",
      "permanent": true
    },
    {
      "source": "/it/strumenti/:slug",
      "destination": "/it/dome/:slug",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.domelayer.com" }],
      "destination": "https://domelayer.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/__spa-fallback.html" },
    { "source": "/auth/callback", "destination": "/__spa-fallback.html" },
    { "source": "/app", "destination": "/__spa-fallback.html" }
  ]
}
