VITE_AUTH_BACKEND=

# Supabase — required for writing consent records to auth.users.raw_user_meta_data
# Find these in your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend API key — used by /api/contact to send contact-form submissions.
RESEND_API_KEY=

# Destination mailbox for contact-form submissions. Defaults to hello@domelayer.com.
CONTACT_EMAIL=
