VITE_AUTH_BACKEND=

# Supabase — required for writing consent records to auth.users.raw_user_meta_data
# Find these in your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend API key — used by /api/contact to send contact-form submissions.
RESEND_API_KEY=

# Destination mailbox for contact-form submissions. Defaults to hello@domelayer.com.
CONTACT_EMAIL=

# Upstash Redis — used by /api/contact for IP rate limiting (3/hour/IP).
# Find these in Upstash console → Redis database → Connect with REST API.
# Required in production; absence triggers fail-closed in production builds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — prefix prepended to the rate-limit key namespace. Used to share
# a single Upstash database across environments without bucket collision.
# Leave empty in production; set to `staging:` on the staging Vercel Preview
# env-var set.
RATELIMIT_PREFIX=
