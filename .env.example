VITE_AUTH_BACKEND=

# Supabase — REQUIRED in production for the GDPR consent flow.
# `src/lib/compliance.ts:isSupabaseConfigured()` gates `writeConsentToSupabase()`
# on both being set; if absent, the consent UI silently no-ops and no record
# is written to `auth.users.raw_user_meta_data` for new sign-ups.
# Find these in your Supabase project dashboard → Settings → API.
# Production project URL is also allow-listed in vercel.json's CSP `connect-src`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend API key — used by /api/contact to send contact-form submissions.
RESEND_API_KEY=

# Destination mailbox for contact-form submissions. Defaults to hello@domelayer.com.
CONTACT_EMAIL=

# Upstash Redis — used by /api/contact for IP rate limiting (3/hour/IP).
# Find these in Upstash console → Redis database → Connect with REST API.
# Required in production; absence triggers fail-closed in production builds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — prefix prepended to the rate-limit key namespace. Used to share
# a single Upstash database across environments without bucket collision.
# Leave empty in production; set to `staging:` on the staging Vercel Preview
# env-var set.
RATELIMIT_PREFIX=

# Sentry — client-side error tracking (optional in dev, recommended in production).
# Create a project at sentry.io and paste the DSN here.
VITE_SENTRY_DSN=
# Overrides the environment tag in Sentry. Falls back to "development" if unset.
# Set to "production" on Vercel Production and "staging" on Vercel Preview.
VITE_SENTRY_ENVIRONMENT=
